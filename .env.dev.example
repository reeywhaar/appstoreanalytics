# The demo's settings, read by ./scripts/run_dev.sh. Copy this to .env.dev, which is yours and is
# not committed, and change what you need.

# Where it is opened, which the webhook addresses under Settings are shown under. It is served on
# this address's port, 80 or 443 when it names none. Unset, http://localhost:8080.
DEV_URL=http://localhost:8080

# The port to serve on instead, for a proxy in front answering at DEV_URL and passing to it.
# DEV_PORT=8080
